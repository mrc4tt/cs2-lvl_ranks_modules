import os

# libmaxminddb is built from third_party/ instead of linking the system's libmaxminddb.a,
# so the module builds the same in every build container and on Windows.
mmdb_path = os.path.join(builder.sourcePath, 'third_party', 'libmaxminddb')

for sdk_target in MMSPlugin.sdk_targets:
  lib = sdk_target.cxx.StaticLibrary('maxminddb')
  lib.compiler.includes += [mmdb_path]
  lib.compiler.defines += ['PACKAGE_VERSION="1.14.1"']
  if lib.compiler.like('gcc'):
    lib.compiler.cflags += ['-Wno-error']
  else:
    lib.compiler.defines += ['_CRT_SECURE_NO_WARNINGS']
  lib.sources += [
    os.path.join(mmdb_path, 'maxminddb.c'),
    os.path.join(mmdb_path, 'data-pool.c'),
  ]
  lib_nodes = builder.Add(lib)

  libs = [lib_nodes]
  if sdk_target.cxx.target.platform == 'windows':
    libs += ['ws2_32.lib']
  MMSPlugin.Module(builder, sdk_target, 'lr_geoip', ['lr_geoip.cpp'],
                   includes = [mmdb_path], libs = libs)
